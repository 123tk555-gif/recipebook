# 開発用のイメージ(Ruby と、gem のビルドに必要なものだけ)。本番用は Dockerfile。
FROM ruby:4.0.7-slim

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y build-essential git pkg-config curl libyaml-dev libssl-dev libvips libjemalloc2 default-mysql-client && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

WORKDIR /rails

# gem は名前付きボリュームに置く(コンテナを作り直しても再インストールしない)
ENV BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_JOBS=4

EXPOSE 3000
CMD ["bin/rails", "server", "-b", "0.0.0.0"]
