<% content_for :title, @recipe.title %>
<% if @recipe.publicly_visible? %>
  <% content_for :ogp do %>
    <%= render "recipes/ogp", recipe: @recipe %>
  <% end %>
<% end %>

<% if @recipe.trashed? %>
  <p class="flash alert" role="status">注意: このレシピはゴミ箱に入っています(あと<%= @recipe.days_until_purge %>日で完全に削除されます)。</p>
<% end %>
<% if @recipe.hidden? && (@recipe.owned_by?(current_user) || current_user&.admin?) %>
  <p class="flash alert" role="status">注意: このレシピは、通報などにより管理者が非公開にしています。持ち主と管理者だけが見られます。</p>
<% end %>

<article class="recipe">
  <h1><%= @recipe.title %></h1>
  <p class="meta">
    <%= @recipe.author_name %><%= " さん" if @recipe.user %>
    <% if @recipe.cooking_minutes %>/ 調理時間 <%= @recipe.cooking_minutes %>分<% end %>
    <% if @recipe.servings %>/ <%= @recipe.servings %>人分<% end %>
    / <strong class="badge"><%= @recipe.publicly_visible? ? "公開" : "非公開" %></strong>
  </p>
  <% if @recipe.viewable_by?(current_user) && !@recipe.trashed? %>
    <%= render "recipes/favorite_button", recipe: @recipe %>
  <% end %>
  <% if @recipe.photo.attached? %>
    <%= image_tag @recipe.photo.variant(:medium), alt: "#{@recipe.title}の写真", class: "photo" %>
  <% end %>
  <% if @recipe.description.present? %><%= simple_format(h(@recipe.description)) %><% end %>
  <% if @recipe.tags.any? %>
    <p class="tags"><% @recipe.tags.each do |tag| %><%= link_to "##{tag.name}", recipes_path(tag: tag.name), class: "tag" %> <% end %></p>
  <% end %>

  <h2>材料</h2>
  <ul class="ingredients">
    <% @recipe.ingredients.each do |ingredient| %>
      <li><span class="name"><%= ingredient.name %></span> <span class="quantity"><%= ingredient.quantity %></span></li>
    <% end %>
  </ul>

  <h2>作り方</h2>
  <ol class="steps">
    <% @recipe.steps.each do |step| %>
      <li><%= step.body %></li>
    <% end %>
  </ol>

  <% if @recipe.publicly_visible? %>
    <%= render "recipes/share", recipe: @recipe %>
  <% end %>

  <% if authenticated? && @recipe.viewable_by?(current_user) && !@recipe.trashed? %>
    <section class="use-recipe" aria-labelledby="use-recipe-heading">
      <h2 id="use-recipe-heading">このレシピを使う</h2>
      <%= form_with url: recipe_shopping_items_path(@recipe), class: "inline-form" do |form| %>
        <p>
          <%= form.label :servings, @recipe.servings ? "何人分の材料を買うか(このレシピは#{@recipe.servings}人分)" : "何人分(このレシピは人数が書かれていないので、分量はそのままです)" %>
          <%= form.number_field :servings, min: 1, max: 100, value: @recipe.servings, disabled: @recipe.servings.nil? %>
        </p>
        <p><%= form.submit "材料を買い物リストに追加" %></p>
      <% end %>
      <%= render "meal_plans/form", recipes: [], default_date: Date.current, selected_recipe: @recipe %>
    </section>
  <% end %>

  <% if @recipe.editable_by?(current_user) %>
    <p class="actions">
      <% if @recipe.trashed? %>
        <%= button_to "元に戻す", restore_trashed_recipe_path(@recipe), method: :post %>
      <% else %>
        <%= link_to "編集", edit_recipe_path(@recipe), class: "button" %>
        <%= button_to "ゴミ箱に移す", recipe_path(@recipe), method: :delete, form_class: "button_to secondary",
                      form: { data: { turbo_confirm: "ゴミ箱に移します。#{Recipe::TRASH_DAYS}日以内なら元に戻せます。" } } %>
      <% end %>
    </p>
  <% end %>

  <% if current_user&.admin? %>
    <section class="admin-box" aria-labelledby="admin-heading">
      <h2 id="admin-heading">管理者の操作</h2>
      <% if @recipe.hidden? %>
        <%= button_to "非公開を解除する", unhide_admin_recipe_path(@recipe), method: :post %>
      <% else %>
        <%= button_to "管理者として非公開にする", hide_admin_recipe_path(@recipe), method: :post, form_class: "button_to danger",
                      form: { data: { turbo_confirm: "このレシピを非公開にします。持ち主と管理者だけが見られるようになります。" } } %>
      <% end %>
    </section>
  <% end %>
</article>

<p class="after-recipe">
  <%= link_to "レシピ一覧に戻る", root_path %>
  <% if authenticated? && @recipe.publicly_visible? && !@recipe.owned_by?(current_user) %>
    <%= link_to "このレシピを通報する", new_recipe_report_path(@recipe), class: "report-link" %>
  <% end %>
</p>
