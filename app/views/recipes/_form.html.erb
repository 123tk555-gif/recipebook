<%= form_with model: recipe do |form| %>
  <%= render "shared/errors", record: recipe %>

  <p>
    <%= form.label :title, "料理名(必須・100文字まで)" %>
    <%= form.text_field :title, required: true, maxlength: 100, autofocus: true %>
  </p>
  <p>
    <%= form.label :description, "説明(2000文字まで)" %>
    <%= form.text_area :description, rows: 4, maxlength: 2000 %>
  </p>
  <p>
    <%= form.label :cooking_minutes, "調理時間(分)" %>
    <%= form.number_field :cooking_minutes, min: 1, max: 1440 %>
  </p>
  <p>
    <%= form.label :servings, "何人分" %>
    <%= form.number_field :servings, min: 1, max: 100 %>
  </p>
  <p>
    <%= form.label :tag_list, "タグ(カンマか空白で区切る・10個まで)" %>
    <%= form.text_field :tag_list %>
  </p>

  <fieldset data-controller="nested-form" data-nested-form-max-value="<%= Recipe::MAX_INGREDIENTS %>" data-nested-form-name-value="材料">
    <legend>材料(<%= Recipe::MAX_INGREDIENTS %>個まで)</legend>
    <div data-nested-form-target="list">
      <%= form.fields_for :ingredients, include_id: false do |f| %>
        <%= render "recipes/ingredient_fields", f: f %>
      <% end %>
    </div>
    <template data-nested-form-target="template">
      <%= form.fields_for :ingredients, Ingredient.new, child_index: "NEW_RECORD", include_id: false do |f| %>
        <%= render "recipes/ingredient_fields", f: f %>
      <% end %>
    </template>
    <p><button type="button" class="secondary" data-action="nested-form#add" data-nested-form-target="addButton">＋ 材料の枠を追加</button></p>
    <p class="row-status" role="status" aria-live="polite" data-nested-form-target="status"></p>
  </fieldset>

  <fieldset data-controller="nested-form" data-nested-form-max-value="<%= Recipe::MAX_STEPS %>" data-nested-form-name-value="手順">
    <legend>作り方(<%= Recipe::MAX_STEPS %>手順まで)</legend>
    <div data-nested-form-target="list">
      <%= form.fields_for :steps, include_id: false do |f| %>
        <%= render "recipes/step_fields", f: f %>
      <% end %>
    </div>
    <template data-nested-form-target="template">
      <%= form.fields_for :steps, Step.new, child_index: "NEW_RECORD", include_id: false do |f| %>
        <%= render "recipes/step_fields", f: f %>
      <% end %>
    </template>
    <p><button type="button" class="secondary" data-action="nested-form#add" data-nested-form-target="addButton">＋ 手順の枠を追加</button></p>
    <p class="row-status" role="status" aria-live="polite" data-nested-form-target="status"></p>
  </fieldset>

  <p>
    <%= form.label :photo, "写真(JPEG・PNG・WebP、5MBまで)" %>
    <%= form.file_field :photo, accept: Recipe::PHOTO_TYPES.join(",") %>
  </p>
  <% if recipe.persisted? && recipe.photo.attached? %>
    <p><%= form.check_box :remove_photo %><%= form.label :remove_photo, "今の写真を削除する" %></p>
  <% end %>

  <p>
    <%= form.check_box :published %>
    <%= form.label :published, "公開する(チェックしないと自分だけが見られます)" %>
  </p>

  <p><%= form.submit recipe.persisted? ? "更新する" : "登録する" %></p>
<% end %>
