<article class="card">
  <% if recipe.photo.attached? %>
    <%= image_tag recipe.photo.variant(:thumb), alt: "#{recipe.title}の写真", loading: "lazy", class: "card-photo" %>
  <% else %>
    <div class="card-photo placeholder"><span class="icon" aria-hidden="true">🍽</span><span>写真なし</span></div>
  <% end %>
  <div class="card-body">
    <h2><%= link_to recipe.title, recipe %></h2>
    <p class="meta">
      <%= recipe.user.display_name %> さん
      <% if recipe.cooking_minutes %>/ <%= recipe.cooking_minutes %>分<% end %>
      <% if recipe.servings %>/ <%= recipe.servings %>人分<% end %>
      / お気に入り <%= recipe.favorites_count %>
      <% unless recipe.published? %>/ <strong class="badge">非公開</strong><% end %>
    </p>
    <% if recipe.tags.any? %>
      <p class="tags"><% recipe.tags.each do |tag| %><%= link_to "##{tag.name}", recipes_path(tag: tag.name), class: "tag" %> <% end %></p>
    <% end %>
  </div>
</article>
