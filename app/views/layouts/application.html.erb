<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || "レシピ管理" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="レシピ管理">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <header class="site-header">
      <div class="site-header-inner">
      <%= link_to root_path, class: "brand" do %><svg class="brand-mark" viewBox="0 0 24 24" width="1.1em" height="1.1em" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9h12v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5z"/><path d="M16 10h1.5a2.5 2.5 0 0 1 0 5H16"/><path d="M8 3c0 1.5 1 1.5 1 3M12 3c0 1.5 1 1.5 1 3"/></svg>レシピ管理<% end %>
      <nav aria-label="メニュー">
        <% if authenticated? %>
          <%= link_to "レシピを書く", new_recipe_path %>
          <%= link_to "マイレシピ", my_recipes_path %>
          <%= link_to "お気に入り", favorites_path %>
          <%= link_to "買い物リスト", shopping_items_path %>
          <%= link_to "献立", meal_plans_path %>
          <%= link_to "ゴミ箱", trashed_recipes_path %>
          <span class="who"><%= current_user.display_name %> さん</span>
          <%= button_to "ログアウト", session_path, method: :delete, class: "link-button" %>
        <% else %>
          <%= link_to "ログイン", new_session_path %>
          <%= link_to "会員登録", new_registration_path %>
        <% end %>
      </nav>
      </div>
    </header>

    <main id="main">
      <% if notice.present? %><p class="flash notice" role="status">お知らせ: <%= notice %></p><% end %>
      <% if alert.present? %><p class="flash alert" role="alert">エラー: <%= alert %></p><% end %>
      <%= yield %>
    </main>
  </body>
</html>
