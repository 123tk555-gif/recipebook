{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BackupObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::__BUCKET__/recipebook/*"
    },
    {
      "Sid": "BackupList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::__BUCKET__"
    },
    {
      "Sid": "ReadAppSecrets",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters"],
      "Resource": "arn:aws:ssm:ap-northeast-1:__ACCOUNT__:parameter/recipebook/*"
    }
  ]
}
