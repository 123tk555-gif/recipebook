# 公開用(compose.prod.yaml)の設定の見本。このファイルをコピーして .env という名前にし、値を書き換える。
# .env は git に入れない(パスワードが入るため)。サーバーでは deploy/aws/user-data.sh がランダムな値を作る。

# データベースのパスワード(長くて推測できないもの。例: openssl rand -hex 24)
DB_ROOT_PASSWORD=ここに長いパスワードを書く
DB_PASSWORD=ここに別の長いパスワードを書く

# Rails の秘密鍵(例: openssl rand -hex 64)。変えると、ログイン中の人は全員ログアウトになる
SECRET_KEY_BASE=ここに長いランダムな文字列を書く

# 公開するドメイン。APP_HOST と SITE_ADDRESS は同じ値にする
# 例: 52-194-241-136.sslip.io(IP アドレスの . を - に変えて .sslip.io を付けると、ドメインなしで使える)
APP_HOST=localhost
#SITE_ADDRESS=

# 公開前に HTTP だけで動作確認するときは false(本番は true のまま)
#FORCE_SSL=false
# 80 番が使えないときの HTTP のポート(このPCでの確認用)
#HTTP_PORT=8080

# メール(Amazon SES の SMTP)。未設定ならメールは送らない
# SMTP_USERNAME / SMTP_PASSWORD は、SES の画面で作る「SMTP 認証情報」(IAM のアクセスキーとは別物)
#SMTP_ADDRESS=email-smtp.ap-northeast-1.amazonaws.com
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
# 送信元。SES で認証したアドレス(またはドメイン)にする
#MAIL_FROM=noreply@example.com

# バックアップの送り先(deploy/backup/backup.sh)。未設定ならサーバーの中にだけ保存する
#BACKUP_S3_BUCKET=
